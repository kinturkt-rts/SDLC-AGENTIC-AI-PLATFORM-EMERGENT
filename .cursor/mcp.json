{
  "mcpServers": {
    "AWS-Postgres-MCP-Server": {
      "disabled": false,
      "timeout": 90,
      "type": "stdio",
      "command": "python",
      "args": [
        "${workspaceFolder}/backend/scripts/postgres_mcp_stdio.py"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    }
  }
}