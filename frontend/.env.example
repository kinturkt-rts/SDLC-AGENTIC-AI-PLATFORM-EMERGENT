# Base URL of a remote platform control-plane REST API (optional).
# Leave empty to read live data from backend/ via Next.js /api/v1 routes.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# CORS allow-list for Next.js API routes (frontend/src/app/api/...).
CORS_ORIGINS=*

# Backend data root (agents/, docs/, inputs/). Default: ../backend
# BACKEND_ROOT=../backend

# Python executable for pipeline runs spawned by POST /api/v1/runs/start.
# Auto-detects backend/.venv when unset.
# ORCHESTRATOR_PYTHON=../backend/.venv/Scripts/python.exe

# S3 artifact store (read from backend/.env.local when unset here).
# API routes load ../backend/.env.local automatically for ARTIFACT_STORE, ARTIFACT_S3_BUCKET, AWS_*.
# ARTIFACT_STORE=s3
# ARTIFACT_S3_BUCKET=your-bucket
# AWS_REGION=us-east-2
# AWS_PROFILE=your-sso-profile

# Pipeline transport: local (subprocess) or a2a (AgentCore). Use a2a for hosted ECS UI.
# SDLC_PIPELINE_TRANSPORT=a2a

# Cloud GitLab publish fallback: how long to wait for developer output before publishing
# (seconds, default 900) and how many publish re-attempts after the first failure (default 2).
# SDLC_GITLAB_FALLBACK_HANDOFF_WAIT_SEC=900
# SDLC_GITLAB_PUBLISH_RETRIES=2

# Frontend-side developer-agent retries. When the orchestrator session dies and leaves
# developer-handoff at status="in_progress", the frontend re-invokes developer-agent
# directly with the Sonnet fallback model before publishing to GitLab. Default 1 retry
# (2 total attempts). GitLab publish is skipped unless the handoff reaches "completed"
# to avoid pushing partially generated apps. Set SDLC_ALLOW_PARTIAL_PUBLISH=true to
# fall back to the old "publish whatever is in S3" behavior.
# SDLC_DEVELOPER_FRONTEND_RETRY_ATTEMPTS=1
# SDLC_DEV_FALLBACK_HANDOFF_WAIT_SEC=900
# SDLC_ALLOW_PARTIAL_PUBLISH=false
# DEVELOPER_AGENT_FALLBACK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Docker / ECS: set BACKEND_ROOT=/backend (see frontend/Dockerfile and deploy/control-plane-frontend/README.md)
