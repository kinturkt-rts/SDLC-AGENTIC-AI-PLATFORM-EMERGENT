# Base URL of a remote platform control-plane REST API (optional).
# Leave empty to read live data from backend/ via Next.js /api/v1 routes.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# CORS allow-list for Next.js API routes (frontend/src/app/api/...).
CORS_ORIGINS=*

# Backend data root (agents/, docs/, inputs/). Default: ../backend
# BACKEND_ROOT=../backend

# Python executable for pipeline runs spawned by POST /api/v1/runs/start.
# Auto-detects backend/.venv when unset.
# ORCHESTRATOR_PYTHON=../backend/.venv/Scripts/python.exe

# Optional: force dry-run transport for all agents (wiring test — no Bedrock).
# Set in frontend/.env.local and restart npm run dev so the subprocess inherits them.
# AGENT_MODE_PRODUCT_AGENT=dry-run
# AGENT_MODE_ARCHITECT_AGENT=dry-run
# AGENT_MODE_DATABASE_AGENT=dry-run
# AGENT_MODE_DEVELOPER_AGENT=dry-run
# AGENT_MODE_GITLAB_AGENT=dry-run
