# Base URL of a remote platform control-plane REST API (optional).
# Leave empty to read live data from backend/ via Next.js /api/v1 routes.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# CORS allow-list for Next.js API routes (frontend/src/app/api/...).
CORS_ORIGINS=*

# Backend data root (agents/, docs/, inputs/). Default: ../backend
# BACKEND_ROOT=../backend

# Python executable for pipeline runs spawned by POST /api/v1/runs/start.
# Auto-detects backend/.venv when unset.
# ORCHESTRATOR_PYTHON=../backend/.venv/Scripts/python.exe

# S3 artifact store (read from backend/.env.local when unset here).
# API routes load ../backend/.env.local automatically for ARTIFACT_STORE, ARTIFACT_S3_BUCKET, AWS_*.
# ARTIFACT_STORE=s3
# ARTIFACT_S3_BUCKET=your-bucket
# AWS_REGION=us-east-2
# AWS_PROFILE=your-sso-profile

# Pipeline transport: local (subprocess) or a2a (AgentCore). Use a2a for hosted ECS UI.
# SDLC_PIPELINE_TRANSPORT=a2a

# Docker / ECS: set BACKEND_ROOT=/backend (see frontend/Dockerfile and deploy/control-plane-frontend/README.md)
