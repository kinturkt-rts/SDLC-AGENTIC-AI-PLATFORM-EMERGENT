# Team Notice Board — environment variables
# Copy this file to .env and fill in real values.
# IMPORTANT: every line must be KEY=value — never paste a bare URL without DATABASE_URL=.

# ── App ─────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
SERVICE_NAME=notice-board-ui

# ── Database (RDS Postgres) ────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://user:password@your-rds-host.rds.amazonaws.com:5432/your_db?sslmode=require
POSTGRES_SCHEMA=notice_board_ui

# ── Auth (organizer shared secret) ──────────────────────────────────────────
ORGANIZER_SECRET=change-me-to-a-strong-secret

# ── Streamlit UI ─────────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000

# ── CORS ────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:8501","http://localhost:8000"]
