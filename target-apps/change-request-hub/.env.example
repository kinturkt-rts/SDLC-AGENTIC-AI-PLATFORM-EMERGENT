# Change Request Hub — Environment Variables
# Copy this file to .env and fill in real values.
# Every line MUST be KEY=value — never paste a bare URL.

APP_ENV=development
LOG_LEVEL=INFO
SERVICE_NAME=change-request-hub

# Postgres RDS
DATABASE_URL=postgresql+psycopg://user:password@agenticaidbinstance.c1u0cggiolxp.us-east-2.rds.amazonaws.com:5432/sdlc_agentic_ai?sslmode=require
POSTGRES_SCHEMA=change_request_hub

# JWT Auth
JWT_SECRET_KEY=change-me-to-a-strong-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# CORS
CORS_ORIGINS=["http://localhost:8501","http://localhost:8000"]
