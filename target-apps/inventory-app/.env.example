# Inventory Desk — environment template
# Copy to .env and fill values for local development.
# Do NOT commit .env. Rotate JWT_SECRET_KEY and seed passwords before production.

# ── App ──────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
SERVICE_NAME=inventory-desk
PORT=8000

# ── Postgres (RDS) ──────────────────────────────────────────────────────
# Format: postgresql+psycopg://<user>:<pwd>@<host>:5432/<dbname>
DATABASE_URL=
POSTGRES_SCHEMA=inventory_app

# ── Auth (JWT bearer, HS256) ────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── CORS (comma-separated) ─────────────────────────────────────────────
# CORS_ORIGINS=http://localhost:3000

# ── Test-only Postgres DSN ──────────────────────────────────────────────
# When set, pytest fixtures use this database (preferred per NFR-11).
# When unset, tests fall back to in-memory SQLite for the baseline run.
# TEST_DATABASE_URL=postgresql+psycopg://user:pwd@localhost:5432/inventory_app_test
