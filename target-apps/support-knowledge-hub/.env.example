# App
APP_ENV=development
SERVICE_NAME=support-knowledge-hub
LOG_LEVEL=INFO

# Database — paste your RDS DSN (must start with DATABASE_URL=)
DATABASE_URL=postgresql+psycopg://postgres:yourpassword@agenticaidbinstance.c1u0cggiolxp.us-east-2.rds.amazonaws.com:5432/sdlc_agentic_ai?sslmode=require
POSTGRES_SCHEMA=support_knowledge_hub

# JWT Auth
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Embedding (MVP uses sentence-transformers locally)
EMBED_MODEL_NAME=all-MiniLM-L6-v2
EMBED_DIM=384
SIMILARITY_THRESHOLD=0.75

# AWS (for future Bedrock integration)
AWS_REGION=us-east-2

# CORS
CORS_ORIGINS=["http://localhost:8501"]
