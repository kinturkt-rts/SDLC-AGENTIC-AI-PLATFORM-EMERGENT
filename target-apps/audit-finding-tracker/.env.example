# Application Environment
APP_ENV=development
DEBUG=true

# Database Configuration
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/database?sslmode=require
POSTGRES_SCHEMA=audit_finding_tracker

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# File Storage
FILE_STORAGE_TYPE=local
LOCAL_UPLOAD_DIR=./data/evidence
MAX_FILE_SIZE_MB=10

# S3 Configuration (production)
AWS_REGION=us-east-2
S3_BUCKET_NAME=your-audit-evidence-bucket
S3_KEY_PREFIX=evidence/