# Healthcare Clinic Assistant — Environment Variables
# Copy to .env and fill in real values. Never commit .env to source control.

# Database — RDS Postgres (URL-encode special chars in password: # → %23)
DATABASE_URL=postgresql+psycopg://postgres:yourpassword@agenticaidbinstance.c1u0cggiolxp.us-east-2.rds.amazonaws.com:5432/sdlc_agentic_ai?sslmode=require
POSTGRES_SCHEMA=healthcare_clinic_bot

# JWT Authentication
JWT_SECRET_KEY=change-me-generate-a-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# AWS Bedrock
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0
AWS_REGION=us-east-2

# FAQ relevance threshold for tsvector search
FAQ_RELEVANCE_THRESHOLD=0.1

# Server
PORT=8000
