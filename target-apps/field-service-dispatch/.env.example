# Field Service Dispatch — environment variables
# Copy this file to .env and fill in real values.
# Every line MUST be KEY=value (never a bare URL without the variable name).

APP_ENV=development
LOG_LEVEL=INFO
SERVICE_NAME=field-service-dispatch

# ── Database (RDS) ──────────────────────────────────────────────────────────
# Paste your full DSN — do NOT omit "DATABASE_URL=" at the start of the line.
DATABASE_URL=postgresql+psycopg://user:password@agenticaidbinstance.c1u0cggiolxp.us-east-2.rds.amazonaws.com:5432/sdlc_agentic_ai?sslmode=require
POSTGRES_SCHEMA=field_service_dispatch

# ── JWT Auth ────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ── SLA ─────────────────────────────────────────────────────────────────────
SLA_BREACH_HOUR=17

# ── AWS region (for future Bedrock / S3 integrations) ───────────────────────
AWS_REGION=us-east-2

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:8501","http://localhost:8000"]
