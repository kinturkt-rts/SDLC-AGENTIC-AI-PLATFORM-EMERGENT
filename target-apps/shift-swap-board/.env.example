# Shift Swap Board - Environment Variables
# Copy this file to .env and fill in real values.
# Every line MUST be KEY=value format.

APP_ENV=development
SERVICE_NAME=shift-swap-board

# Postgres RDS connection
# Paste the full DSN — do NOT paste a bare URL without DATABASE_URL=
DATABASE_URL=postgresql+psycopg://user:password@agenticaidbinstance.c1u0cggiolxp.us-east-2.rds.amazonaws.com:5432/sdlc_agentic_ai?sslmode=require
POSTGRES_SCHEMA=shift_swap_board

# JWT Auth
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=8

# API URL for Streamlit UI
API_BASE_URL=http://localhost:8000
