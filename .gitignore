# Secrets & environment (.env.example files are committed with placeholders only)
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/

# Node / frontend (control-plane UI)
node_modules/
dist/
frontend/.next/
frontend/out/
frontend/next-env.d.ts
frontend/data/

# Logs & auth caches
*.log
.mcp-auth/

# IDE & OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Stale AgentCore config backups (machine-local OneDrive / path copies)
*.bak-onedrive
backend/.bedrock_agentcore.yaml.bak*

# Local MCP binary (GitLab MCP is ECS HTTP; see backend/deploy/gitlab-mcp-server/)
bin/

# Per-app Terraform deploy roots (regenerated by devops-agent from the deploy
# manifest on every deploy; _shared/ is the hand-maintained base infra, keep it)
backend/infrastructure/environments/dev/*/
!backend/infrastructure/environments/dev/_shared/

# Pipeline runtime (orchestrator subprocess logs, misplaced handoff snapshots)
backend/agents/pipeline/.logs/
backend/agents/pipeline/runs/
backend/agents/pipeline/*-telemetry.json
# devops handoffs hold generated runtime secrets (extraEnv) — never commit
backend/agents/pipeline/*.devops-handoff.json
backend/*/context.json
backend/.tmp/
backend/demo-api/
backend/incident-triage-bot/
backend/$null

