# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
SERVICE_NAME=training-compliance
LOG_LEVEL=INFO

# ── PostgreSQL (RDS) ─────────────────────────────────────────────────────────
# IMPORTANT: Every line must be KEY=value. Never paste a bare URL without DATABASE_URL=.
DATABASE_URL=postgresql+psycopg://postgres:yourpassword@agenticaidbinstance.c1u0cggiolxp.us-east-2.rds.amazonaws.com:5432/sdlc_agentic_ai?sslmode=require
POSTGRES_SCHEMA=training_compliance

# ── JWT Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-strong-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── AWS Region (platform default) ───────────────────────────────────────────
AWS_REGION=us-east-2

# ── CORS (comma-separated origins) ──────────────────────────────────────────
CORS_ORIGINS=["http://localhost:8501","http://localhost:8000"]
