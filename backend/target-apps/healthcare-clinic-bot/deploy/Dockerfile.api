# FastAPI backend container — built with the app directory as context:
#   docker build -f deploy/Dockerfile.api -t <app>-api .
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8000

# serve_api.py strips API_PATH_PREFIX for ALB path routing (api-only apps);
# falls back to plain uvicorn for apps built before the wrapper existed.
CMD ["sh", "-c", "if [ -f deploy/serve_api.py ]; then python deploy/serve_api.py; else uvicorn app.main:app --host 0.0.0.0 --port 8000; fi"]
