# Platform Desk - Environment Configuration
# Copy this file to .env and fill in real values.
# Every line MUST be KEY=value format.

APP_ENV=development
SERVICE_NAME=platform-desk

# Postgres RDS - use postgresql+psycopg:// driver (NOT psycopg2)
DATABASE_URL=postgresql+psycopg://postgres:yourpassword@agenticaidbinstance.c1u0cggiolxp.us-east-2.rds.amazonaws.com:5432/sdlc_agentic_ai?sslmode=require
POSTGRES_SCHEMA=platform_desk

# API Key - single key for dev (matches seed data)
API_KEY=RunbookDesk2024!

# Vector search (ChromaDB + sentence-transformers)
CONFIDENCE_THRESHOLD=0.45
CHROMA_PERSIST_DIR=./chroma_data
EMBEDDING_MODEL=all-MiniLM-L6-v2

# CORS
CORS_ORIGINS=["*"]
