# Streamlit UI container — built with the app directory as context:
#   docker build -f deploy/Dockerfile.ui -t <app>-ui .
# Runtime config (port, baseUrlPath, API_BASE_URL) comes from STREAMLIT_* /
# API_BASE_URL env vars set by the ECS task definition.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY . .
RUN if [ -f ui/requirements.txt ]; then \
        pip install --no-cache-dir -r ui/requirements.txt; \
    else \
        pip install --no-cache-dir -r requirements.txt; \
    fi

EXPOSE 8501

CMD ["streamlit", "run", "ui/streamlit_app.py"]
