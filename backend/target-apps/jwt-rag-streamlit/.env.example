# Service Configuration
SERVICE_NAME=jwt-rag-streamlit
APP_ENV=development
PORT=8000
SKIP_STARTUP_CHECKS=0

# Database Configuration (copy from .env, don't paste bare URL)
DATABASE_URL=postgresql+psycopg://username:password@host:port/database?sslmode=require
POSTGRES_SCHEMA=jwt_rag_streamlit

# JWT Authentication
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# AWS Bedrock Configuration
AWS_REGION=us-east-2
BEDROCK_REGION=us-east-2
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# RAG Configuration
EMBED_DIM=1024
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5
CONFIDENCE_THRESHOLD=0.25

# PDF Storage
PDF_STORAGE_DIR=./uploaded_pdfs

# Streamlit UI Configuration (for ui/streamlit_app.py)
API_BASE_URL=http://localhost:8000
