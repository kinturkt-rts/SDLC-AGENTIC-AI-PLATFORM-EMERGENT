# -- App --
APP_ENV=development
LOG_LEVEL=INFO
SERVICE_NAME=expense-tracker

# -- Postgres RDS --
# Every line must be KEY=value. Paste the full DSN after the = sign.
DATABASE_URL=postgresql+psycopg://postgres:yourpassword@your-rds-host.us-east-2.rds.amazonaws.com:5432/Test_db?sslmode=require
POSTGRES_SCHEMA=expense_tracker

# -- JWT (unused in api-key mode but config expects it) --
JWT_SECRET_KEY=not-used-in-api-key-mode
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# -- CORS --
CORS_ORIGINS=["*"]

# -- AWS --
AWS_REGION=us-east-2
