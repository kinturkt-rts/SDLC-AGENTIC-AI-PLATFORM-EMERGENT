# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
SERVICE_NAME=team-faq-bot
PORT=8000

# ── Database (Postgres / RDS) ─────────────────────────────────────────────────
# Format: postgresql+psycopg://<user>:<password>@<endpoint>:5432/<database>?sslmode=require
# URL-encode special chars in passwords (e.g. # → %23).
# IMPORTANT: Do NOT paste a bare URL. Always include DATABASE_URL= prefix.
DATABASE_URL=postgresql+psycopg://user:password@agenticaidbinstance.c1u0cggiolxp.us-east-2.rds.amazonaws.com:5432/sdlc_agentic_ai?sslmode=require
POSTGRES_SCHEMA=team_faq_bot

# ── Auth (API-key) ────────────────────────────────────────────────────────────
# User key (for POST /api/v1/ask)
API_KEY=dev-api-key-change-me
# Admin key (for POST /api/v1/upload, GET /api/v1/gaps)
ADMIN_API_KEY=dev-admin-key-change-me

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=*

# ── AWS / Bedrock ─────────────────────────────────────────────────────────────
AWS_REGION=us-east-2
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_MAX_TOKENS=1024
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# ── RAG / Retrieval ───────────────────────────────────────────────────────────
EMBED_DIM=1024
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5
CONFIDENCE_THRESHOLD=0.75

# ── FAQ-specific ──────────────────────────────────────────────────────────────
FAQ_MAX_CHARS=50000
RETENTION_DAYS=90
