# Benefits Q&A Desk — environment configuration
# Copy to .env and fill in real values.
# IMPORTANT: Every line must be KEY=value — do not paste a bare URL.

APP_ENV=development
SERVICE_NAME=benefits-qa-desk

# Postgres RDS
DATABASE_URL=postgresql+psycopg://user:password@agenticaidbinstance.c1u0cggiolxp.us-east-2.rds.amazonaws.com:5432/sdlc_agentic_ai?sslmode=require
POSTGRES_SCHEMA=benefits_qa_desk

# JWT Auth
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_TTL_HOURS=8

# AWS / Bedrock
AWS_REGION=us-east-2
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0
BEDROCK_MAX_TOKENS=4096
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# RAG / pgvector
EMBED_DIM=1024
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5
CONFIDENCE_THRESHOLD=0.75
PDF_STORAGE_DIR=./uploaded_pdfs
