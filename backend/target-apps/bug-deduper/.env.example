# Bug Deduper — copy this file to .env and fill in real values
# Each line MUST be KEY=value — never paste a bare URL without the variable name.

APP_ENV=development
SERVICE_NAME=bug-deduper

# Postgres RDS
DATABASE_URL=postgresql+psycopg://user:password@agenticaidbinstance.c1u0cggiolxp.us-east-2.rds.amazonaws.com:5432/sdlc_agentic_ai?sslmode=require
POSTGRES_SCHEMA=bug_deduper

# API keys (plaintext values that match the bcrypt hashes in api_keys table)
API_KEY_STANDARD=dev-standard-key
API_KEY_ADMIN=dev-admin-key

# AWS / Bedrock
AWS_REGION=us-east-2
BEDROCK_REGION=us-east-2
BEDROCK_MODEL_ID=amazon.titan-embed-text-v2:0
# Optional override — default derived from model (v1=1536, v2=1024). Must match bug_deduper.bugs.embedding vector(n).
# EMBEDDING_DIMENSION=1024

# Dedup configuration
SIMILARITY_THRESHOLD=0.85
TOP_K=3

# CORS
CORS_ORIGINS=["*"]

# Logging
LOG_LEVEL=INFO
