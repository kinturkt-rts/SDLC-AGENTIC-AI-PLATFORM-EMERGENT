{
  "version": 1,
  "templateRoot": "target-apps/_template",
  "patterns": {
    "B": {
      "copy_verbatim": [
        "app/__init__.py",
        "app/database.py",
        "app/startup_checks.py",
        "app/dependencies.py",
        "app/security.py",
        "app/routers/__init__.py",
        "app/routers/health.py",
        "app/routers/auth.py",
        "app/models/__init__.py",
        "app/models/pg_types.py",
        "schemas/__init__.py",
        "schemas/common.py",
        "schemas/auth.py",
        "requirements.txt",
        ".gitignore",
        ".env.example",
        "README.md",
        "pytest.ini",
        "tests/test_health.py"
      ],
      "copy_as": {
        "tests/conftest_reference.py": "tests/conftest.py",
        "tests/test_schema_datetime_reference.py": "tests/test_schema_datetime.py"
      },
      "seed_from_template": [
        "app/config.py",
        "app/main.py"
      ]
    },
    "B-api-key": {
      "copy_verbatim": [
        "app/__init__.py",
        "app/database.py",
        "app/startup_checks.py",
        "app/routers/__init__.py",
        "app/routers/health.py",
        "app/routers/me.py",
        "app/models/__init__.py",
        "app/models/pg_types.py",
        "schemas/__init__.py",
        "schemas/common.py",
        "requirements.txt",
        ".gitignore",
        ".env.example",
        "README.md",
        "pytest.ini",
        "tests/test_health.py"
      ],
      "copy_as": {
        "app/dependencies_apikey.py": "app/dependencies.py",
        "tests/conftest_reference.py": "tests/conftest.py",
        "tests/test_schema_datetime_reference.py": "tests/test_schema_datetime.py"
      },
      "seed_from_template": [
        "app/config.py",
        "app/main.py"
      ]
    },
    "B+": {
      "extends": "B",
      "copy_verbatim": [
        "app/services/__init__.py",
        "app/services/bedrock_client.py"
      ]
    },
    "B++": {
      "extends": "B+",
      "copy_verbatim": [
        "app/services/ingestion.py",
        "app/services/pgvector_retriever.py",
        "app/services/prompts.py"
      ]
    },
    "C": {
      "extends": "B+",
      "copy_verbatim": [
        "ui/streamlit_app.py",
        "ui/requirements.txt"
      ]
    },
    "F": {
      "copy_verbatim": [
        "frontend/index.html",
        "frontend/package.json",
        "frontend/vite.config.ts",
        "frontend/tsconfig.json",
        "frontend/tsconfig.app.json",
        "frontend/tsconfig.node.json",
        "frontend/.gitignore",
        "frontend/.env",
        "frontend/src/main.tsx",
        "frontend/src/api.ts",
        "frontend/src/App.tsx",
        "frontend/src/index.css",
        "frontend/components.json",
        "frontend/src/lib/utils.ts",
        "frontend/src/Shell.tsx",
        "frontend/src/components/ui/button.tsx",
        "frontend/src/components/ui/input.tsx",
        "frontend/src/components/ui/textarea.tsx",
        "frontend/src/components/ui/label.tsx",
        "frontend/src/components/ui/select.tsx",
        "frontend/src/components/ui/table.tsx",
        "frontend/src/components/ui/card.tsx",
        "frontend/src/components/ui/badge.tsx",
        "frontend/src/components/ui/dialog.tsx",
        "frontend/src/components/ui/alert.tsx"
      ]
    },
    "F-api-key": {
      "copy_verbatim": [
        "frontend/index.html",
        "frontend/package.json",
        "frontend/vite.config.ts",
        "frontend/tsconfig.json",
        "frontend/tsconfig.app.json",
        "frontend/tsconfig.node.json",
        "frontend/.gitignore",
        "frontend/.env",
        "frontend/src/main.tsx",
        "frontend/src/App.tsx",
        "frontend/src/index.css",
        "frontend/components.json",
        "frontend/src/lib/utils.ts",
        "frontend/src/Shell.tsx",
        "frontend/src/components/ui/button.tsx",
        "frontend/src/components/ui/input.tsx",
        "frontend/src/components/ui/textarea.tsx",
        "frontend/src/components/ui/label.tsx",
        "frontend/src/components/ui/select.tsx",
        "frontend/src/components/ui/table.tsx",
        "frontend/src/components/ui/card.tsx",
        "frontend/src/components/ui/badge.tsx",
        "frontend/src/components/ui/dialog.tsx",
        "frontend/src/components/ui/alert.tsx"
      ],
      "copy_as": {
        "frontend/src/api_apikey.ts": "frontend/src/api.ts"
      }
    }
  },
  "customize_after_scaffold": [
    "app/config.py",
    "app/main.py",
    "tests/conftest.py",
    ".env.example",
    "README.md",
    "requirements.txt",
    "ui/streamlit_app.py"
  ]
}
