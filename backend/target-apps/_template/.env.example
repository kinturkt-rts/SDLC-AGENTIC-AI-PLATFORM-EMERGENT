# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
SERVICE_NAME=service-template

# ── Database (Postgres / RDS) ─────────────────────────────────────────────────
# Format: postgresql+psycopg://<user>:<password>@<endpoint>:5432/<database>?sslmode=require
# URL-encode special chars in passwords (e.g. # → %23).
# IMPORTANT: Do NOT paste a bare URL. Always include DATABASE_URL= prefix.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/mydb?sslmode=require
# Schema name set by database-agent (e.g. meeting_assistant, finops_web_app)
POSTGRES_SCHEMA=public

# ── Auth ──────────────────────────────────────────────────────────────────────
# API-key auth: set a shared secret; Streamlit ui/ reads the same key.
API_KEY=dev-api-key-change-me
# JWT auth: uncomment if design uses JWT bearer tokens.
# JWT_SECRET_KEY=change-me-to-a-random-string
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=60

# ── CORS (comma-separated origins, or * for dev) ─────────────────────────────
CORS_ORIGINS=*

# ── AWS (Bedrock / S3 / etc.) — omit when design has no AI ───────────────────
AWS_REGION=us-east-2
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0
# BEDROCK_MAX_TOKENS=4096

# ── RAG / pgvector — only when design uses document Q&A ──────────────────────
# BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
# EMBED_DIM=1024
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# RETRIEVAL_TOP_K=5
# CONFIDENCE_THRESHOLD=0.25
# PDF_STORAGE_DIR=./var/pdfs
