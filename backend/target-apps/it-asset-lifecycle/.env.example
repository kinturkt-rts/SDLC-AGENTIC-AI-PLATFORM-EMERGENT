# Environment
APP_ENV=development
LOG_LEVEL=INFO
SERVICE_NAME=it-asset-lifecycle

# Database — paste your RDS DSN here
DATABASE_URL=postgresql+psycopg://postgres:yourpassword@agenticaidbinstance.c1u0cggiolxp.us-east-2.rds.amazonaws.com:5432/sdlc_agentic_ai?sslmode=require
POSTGRES_SCHEMA=it_asset_lifecycle

# JWT
JWT_SECRET=change-me-to-a-strong-random-string
JWT_TTL_HOURS=8

# Fernet encryption key for license keys
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ASSET_ENCRYPTION_KEY=your-fernet-key-here

# AWS (region must match RDS/Bedrock)
AWS_REGION=us-east-2

# CORS
CORS_ORIGINS=["http://localhost:8501"]
