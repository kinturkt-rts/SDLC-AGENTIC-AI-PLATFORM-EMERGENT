# IT Asset Lifecycle Management — Environment Variables
# Copy this file to .env and fill in real values.
# Every line MUST be KEY=value format.

# App
APP_ENV=development
LOG_LEVEL=INFO
SERVICE_NAME=it-asset-lifecycle

# Postgres RDS
DATABASE_URL=postgresql+psycopg://postgres:yourpassword@your-rds-host.us-east-2.rds.amazonaws.com:5432/Test_db?sslmode=require
POSTGRES_SCHEMA=it_asset_lifecycle

# JWT Auth
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# License key encryption
ASSET_ENCRYPTION_KEY=change-me-to-a-fernet-key

# CORS
CORS_ORIGINS=["*"]
