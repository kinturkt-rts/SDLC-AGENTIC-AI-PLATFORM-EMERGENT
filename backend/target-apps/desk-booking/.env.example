# Desk Booking API — environment configuration
# Copy to .env and fill in actual values.
# Every line needs the variable name — paste DATABASE_URL=postgresql+psycopg://..., not a bare URL.

APP_ENV=development
LOG_LEVEL=INFO
SERVICE_NAME=desk-booking

# Postgres RDS
DATABASE_URL=postgresql+psycopg://user:password@your-rds-host.us-east-2.rds.amazonaws.com:5432/Test_db?sslmode=require
POSTGRES_SCHEMA=desk_booking

# Auth
ADMIN_KEY=change-me-admin-key
API_KEY=change-me-api-key

# CORS
CORS_ORIGINS=["*"]
