# Field Service Dispatch - Environment Variables
# Copy to .env and fill in real values

APP_ENV=development
LOG_LEVEL=INFO
SERVICE_NAME=field-service-dispatch

# Database (RDS Postgres)
# Every line MUST be KEY=value. Never paste a bare URL without DATABASE_URL= prefix.
DATABASE_URL=postgresql+psycopg://user:password@agenticaidbinstance.c1u0cggiolxp.us-east-2.rds.amazonaws.com:5432/sdlc_agentic_ai?sslmode=require
POSTGRES_SCHEMA=field_service_dispatch

# Auth - API key (used by Streamlit UI and manual testing)
API_KEY=change-me-to-a-real-secret

# SLA cutoff hour (24h format, UTC)
SLA_CUTOFF_HOUR=17

# AWS Region
AWS_REGION=us-east-2
