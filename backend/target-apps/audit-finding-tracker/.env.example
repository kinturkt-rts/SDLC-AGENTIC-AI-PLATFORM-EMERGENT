# Audit Finding Tracker - Environment Configuration
# Copy this file to .env and fill in your values
# Every line MUST be KEY=value format

# Application
APP_ENV=development
LOG_LEVEL=INFO
SERVICE_NAME=Audit Finding Tracker

# PostgreSQL RDS
# IMPORTANT: paste the full DSN including DATABASE_URL= prefix
DATABASE_URL=postgresql+psycopg://postgres:yourpassword@your-rds-host.us-east-2.rds.amazonaws.com:5432/Test_db?sslmode=require
POSTGRES_SCHEMA=audit_finding_tracker

# JWT Authentication
JWT_SECRET_KEY=change-me-to-a-strong-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Evidence file storage
EVIDENCE_DIR=data/evidence

# CORS
CORS_ORIGINS=["http://localhost:8501","http://localhost:8000"]
