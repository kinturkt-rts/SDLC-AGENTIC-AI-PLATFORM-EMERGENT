AWS_PROFILE=your-profile
AWS_REGION=us-east-2

# Prefer AWS SSO: set AWS_PROFILE to your CLI profile and run `aws sso login`.
# Do not commit static session keys; leave them unset when using SSO.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Default chat/reasoning model used by most agents (must be a real Bedrock model ID).
MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0
# Heavy coding model for developer-agent / database-agent. Override with the actual
# Opus Bedrock model ID enabled in your AWS account, e.g. us.anthropic.claude-opus-4-1-20250805-v1:0
CODING_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0
BEDROCK_READ_TIMEOUT=600
DATABASE_AGENT_MAX_TOKENS=32768
DEVELOPER_AGENT_MAX_TOKENS=32768

# Set to 1 to stream Opus extended thinking to stderr during the run (extra token cost)
# DEVELOPER_AGENT_THINKING=1
# DEVELOPER_AGENT_THINKING_BUDGET=8192

# Set to 1 to enable verbose RDS apply output from database-agent
# DATABASE_AGENT_VERBOSE=1

SEED_MIN_ROWS=5
SEED_MAX_ROWS=10

GITLAB_PERSONAL_ACCESS_TOKEN=
GITLAB_TOKEN=
GITLAB_URL=https://code.junodev.net
GITLAB_API_URL=https://code.junodev.net/api/v4
GITLAB_PROJECT_PATH=junolabs/sdlc-agentic-ai-platform/sdlc-agentic-ai-platform
GITLAB_BASE_BRANCH=main
ATLASSIAN_MCP_TOKEN=

# GitHub (github-agent publish to showcase repo — Phase 1 MVP)
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_OWNER=kinturkt-rts
GITHUB_REPO=SDLC-Agentic-AI-Platform
GITHUB_BASE_BRANCH=main

# AWS Labs Postgres MCP
POSTGRES_MCP_CONNECTION_METHOD=PG_WIRE_PROTOCOL
POSTGRES_MCP_DEPLOYMENT=instance
POSTGRES_MCP_INSTANCE_IDENTIFIER=your_db_instance_name
POSTGRES_MCP_DB_ENDPOINT=your-rds-host.rds.amazonaws.com
POSTGRES_MCP_DATABASE=your_db_name
POSTGRES_MCP_DB_USER=your_db_username
POSTGRES_MCP_DB_PASSWORD=your_db_password
POSTGRES_MCP_PORT=5432
POSTGRES_MCP_ALLOW_WRITE=1
FIRECRAWL_API_KEY=fc-d8bb810210e3446594a109c17a5e6bbe