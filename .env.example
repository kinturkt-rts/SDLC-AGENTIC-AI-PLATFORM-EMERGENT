AWS_PROFILE=your-profile
AWS_REGION=us-east-2

# Artifact storage configuration (s3 or local)
ARTIFACT_STORE=s3
ARTIFACT_S3_BUCKET=sdlc-agent-artifacts-your-account-region
ARTIFACT_DYNAMODB_TABLE=sdlc-pipeline-runs

# Prefer AWS SSO: set AWS_PROFILE to your CLI profile and run `aws sso login`.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

GITLAB_PERSONAL_ACCESS_TOKEN=
GITLAB_URL=https://code.junodev.net
GITLAB_API_URL=https://code.junodev.net/api/v4
GITLAB_PROJECT_PATH=junolabs/sdlc-agentic-ai-platform/sdlc-agentic-ai-platform-apps
GITLAB_BASE_BRANCH=main
# GitLab MCP URLs: see config/agentcore/gitlab-mcp-endpoints.json (platform defaults).
# AgentCore deploy sets GITLAB_MCP_HTTP_DIRECT_URL from that file. Override only if needed:
# GITLAB_MCP_HTTP_DIRECT_URL=http://gitlab-mcp-alb-....elb.amazonaws.com/mcp
# GITLAB_MCP_URL=https://....cloudfront.net/mcp
# Atlassian Rovo MCP (product-agent Jira backlog). Headless AgentCore: email + API token (org admin must enable API token auth).
# echo -n "you@example.com:YOUR_TOKEN" | base64  →  ATLASSIAN_MCP_BASIC_AUTH (optional alternative)
ATLASSIAN_MCP_EMAIL=
ATLASSIAN_MCP_TOKEN=
# AGENTCORE_PRODUCT_JIRA=true  # set before deploy-agentcore-agents.ps1 to allow opt-in Jira on cloud runs

# AWS Labs Postgres MCP
POSTGRES_MCP_CONNECTION_METHOD=PG_WIRE_PROTOCOL
POSTGRES_MCP_DEPLOYMENT=instance
POSTGRES_MCP_INSTANCE_IDENTIFIER=your_db_instance_name
POSTGRES_MCP_DB_ENDPOINT=your-rds-host.rds.amazonaws.com
POSTGRES_MCP_DATABASE=your_db_name
POSTGRES_MCP_DB_USER=your_db_username
POSTGRES_MCP_DB_PASSWORD=your_db_password
POSTGRES_MCP_PORT=5432
POSTGRES_MCP_ALLOW_WRITE=1
FIRECRAWL_API_KEY=your_firecrawl_key